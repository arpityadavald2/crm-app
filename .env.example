NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
SERVICE_NAME=crm-app
APP_VERSION=0.1.0

# --- local docker compose (dev only) ---
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=crm
MYSQL_USER=crm_app
MYSQL_PASSWORD=change_me_app

# --- app database connection ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=crm
DB_USER=crm_app
DB_PASSWORD=change_me_app
DB_POOL_SIZE=10

# --- auth ---
JWT_SECRET=change_me_to_a_long_random_string_min_32_chars
JWT_ACCESS_TTL_SECONDS=900

# --- redis / background worker ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REMINDER_CRON=0 9 * * *
